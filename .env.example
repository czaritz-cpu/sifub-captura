# ─── Google OAuth (para login con Google) ─────────────────────────────────────
# Obtenlos en: console.cloud.google.com → APIs → Credenciales → OAuth 2.0
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ─── Google Service Account (para leer Sheets y escribir en Drive) ─────────────
# JSON completo en UNA sola línea (sin saltos de línea)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"tu-proyecto",...}

# ─── Google Sheets ─────────────────────────────────────────────────────────────
# ID del Sheet (parte de la URL: docs.google.com/spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=1ABCxyz...
GOOGLE_SHEET_NAME=general

# ─── Google Drive ──────────────────────────────────────────────────────────────
# ID de la carpeta raíz donde se crearán los expedientes
# (parte final de la URL de Drive: drive.google.com/drive/folders/ESTE_ID)
GOOGLE_DRIVE_FOLDER_ID=1ABCxyz...

# ─── URL de tu app en Netlify (se llena automáticamente en Netlify) ────────────
URL=https://tu-app.netlify.app

# ─── Usuarios autorizados (JSON array) ────────────────────────────────────────
# rol puede ser: "admin" o "capturista"
# Agrega un objeto por cada persona que puede entrar con su Gmail
ALLOWED_USERS=[{"email":"tu@gmail.com","nombre":"Administrador","rol":"admin"},{"email":"capturista1@gmail.com","nombre":"Juan Pérez","rol":"capturista"}]
